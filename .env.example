# =========================================================================
# .env.example — copy to .env locally and fill in real values.
# This file IS committed; the real .env is gitignored.
# In production (Fly.io etc.) set each value via the platform's secrets store.
# =========================================================================

# --- Auth (REQUIRED in prod) ---------------------------------------------
# ENV controls auth strictness. Set to "production" on Fly.io.
ENV=development
# 48+ random bytes. Generate locally with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Single-user app — admin login credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: token validity in hours (default 24).
JWT_EXPIRE_HOURS=24

# --- CORS (REQUIRED in prod) ---------------------------------------------
# Comma-separated list of deployed frontend origins (no trailing slash).
# Example: https://t-dashboard.vercel.app,https://my-domain.com
CORS_ORIGINS=

# --- Database -------------------------------------------------------------
# Path to the SQLite file. On Fly.io point this at the mounted volume.
DB_PATH=fyers_data.db

# --- Fyers API (only needed if you run the original scanner/sync features) -
# Get these from https://myapi.fyers.in — these are SECRETS.
CLIENT_ID=
CLIENT_APP_ID=
APP_SECRET=
FYERS_PIN=
ACCESS_TOKEN=
REFRESH_TOKEN=
REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
AUTH_CODE_URL=https://api-t1.fyers.in/api/v3/generate-authcode
VALIDATE_URL=https://api-t1.fyers.in/api/v3/validate-authcode
VALIDATE_REFRESH_URL=https://api-t1.fyers.in/api/v3/validate-refresh-token
AUTO_CAPTURE_AUTH=false

# --- OpenAI (only if you use the AI analysis feature) --------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Data sync configuration ---------------------------------------------
DATA_DIR=data
DATA_WEEK_DIR=data/week
DATA_MONTH_DIR=data/month
START_WEEK_DATE=2023-01-01
START_MONTH_DATE=2023-01-01

# Comma-separated F&O stocks the sync job pulls.
FO_STOCKS=NSE:RELIANCE-EQ,NSE:TCS-EQ,NSE:INFY-EQ
# Intraday monitor symbols + interval (minutes)
DAY_ENTRY_STOCKS=NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX
DAY_ENTRY_INTERVAL=5
